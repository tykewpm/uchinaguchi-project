---
import Base from '../layouts/Base.astro';
import Videos from '../components/pages/Videos.astro';
import { useTranslations } from '../i18n/ui.js';
const lang = 'en';
const t = useTranslations(lang);
---
<Base lang={lang} path="videos" title={`${t('videos.title')} — The Uchinaguchi Project`}>
  <Videos lang={lang} />
</Base>
