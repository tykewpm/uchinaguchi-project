---
import Base from '../layouts/Base.astro';
import dict from '../../data/dictionary.clean.json';
const entries = dict.entries;
const categories = [...new Set(entries.map((e) => e.category))].sort();
---
<Base title="Dictionary — The Uchinaguchi Project" description="A growing, speaker-checked Uchinaaguchi (Okinawan) dictionary.">
  <section>
    <div class="container">
      <h1>Uchinaaguchi Dictionary</h1>
      <p style="color:var(--muted);max-width:680px">
        A small, honest, growing dictionary of Uchinaaguchi (Central Okinawan). Search in
        English or rōmaji, or filter by category.
      </p>

      <div class="notice">
        <strong>Work in progress.</strong> Every entry below is awaiting review by a fluent
        speaker, and pronunciations show as "audio coming" until we record real Okinawan
        voices — we never use synthetic Japanese audio. Spot something wrong?
        Corrections from speakers are always welcome.
      </div>

      <div class="dict-tools">
        <input id="search" class="search" type="search" placeholder="Search words, meanings, rōmaji…" aria-label="Search the dictionary" />
        <div class="filters" id="filters">
          <button class="chip" data-cat="all" aria-pressed="true">All</button>
          {categories.map((c) => <button class="chip" data-cat={c} aria-pressed="false">{c}</button>)}
        </div>
      </div>

      <p id="count" style="color:var(--muted);font-size:.9rem"></p>

      <div class="word-grid" id="grid">
        {entries.map((e) => (
          <article class="word-card" data-cat={e.category} data-search={`${e.headword} ${e.romaji} ${e.english.join(' ')} ${e.category}`.toLowerCase()}>
            <div class="word-head">
              <h2 class="headword">{e.headword}</h2>
              <span class="audio-soon" title="Real Okinawan audio is coming — we don't use synthetic Japanese TTS.">🔊 audio coming</span>
            </div>
            <div class="romaji">{e.romaji} {e.ipa && <span class="ipa">{e.ipa}</span>}</div>
            <p class="gloss">{e.english.join('; ')}</p>
            {e.examples && e.examples.length > 0 && (
              <p class="example"><em>{e.examples[0].okinawan}</em> — {e.examples[0].english}</p>
            )}
            <div class="word-foot">
              <span class="cat-tag">{e.category}</span>
              <span class="badge-validate">needs validation</span>
            </div>
          </article>
        ))}
      </div>
      <div class="no-results" id="noResults">No matches. Try a different word.</div>
    </div>
  </section>

  <script>
    const search = document.getElementById('search');
    const grid = document.getElementById('grid');
    const cards = Array.from(grid.querySelectorAll('.word-card'));
    const chips = Array.from(document.querySelectorAll('.chip'));
    const count = document.getElementById('count');
    const noResults = document.getElementById('noResults');
    let activeCat = 'all';

    function apply() {
      const q = (search.value || '').toLowerCase().trim();
      let visible = 0;
      cards.forEach((card) => {
        const matchesCat = activeCat === 'all' || card.dataset.cat === activeCat;
        const matchesQ = !q || card.dataset.search.includes(q);
        const show = matchesCat && matchesQ;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      count.textContent = `${visible} word${visible === 1 ? '' : 's'}`;
      noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    search.addEventListener('input', apply);
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');
        activeCat = chip.dataset.cat;
        apply();
      });
    });
    apply();
  </script>
</Base>
