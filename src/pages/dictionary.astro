---
import Base from '../layouts/Base.astro';
import base from '../../data/dictionary.clean.json';
import wik from '../../data/wiktionary-import.json';

// Merge the hand-curated seed with the Wiktionary/Kaikki import, de-duplicating by headword.
const seen = new Set();
const entries = [];
for (const e of [...base.entries, ...wik.entries]) {
  const key = (e.headword || '').toLowerCase().trim();
  if (!key || seen.has(key)) continue;
  seen.add(key);
  entries.push(e);
}
entries.sort((a, b) => a.headword.localeCompare(b.headword));
const categories = [...new Set(entries.map((e) => e.category))].sort();
const total = entries.length;
---
<Base title="Dictionary — The Uchinaguchi Project" description="A growing, speaker-checked Uchinaaguchi (Okinawan) dictionary. Look up the Okinawan word for any English term.">
  <section>
    <div class="container">
      <h1>Uchinaaguchi Dictionary</h1>
      <p style="color:var(--muted);max-width:680px">
        {total} entries of Uchinaaguchi (Central Okinawan). <strong>Type an English word</strong>
        (like “water” or “thank you”) to find the Okinawan equivalent — or search in rōmaji or kana.
      </p>

      <div class="notice">
        <strong>Work in progress — every entry awaits fluent-speaker review.</strong>
        Many entries are sourced from <a href="https://en.wiktionary.org" target="_blank" rel="noopener">Wiktionary</a>
        (CC BY-SA 4.0, via <a href="https://kaikki.org/dictionary/Okinawan/" target="_blank" rel="noopener">Kaikki.org</a>),
        and their romanization is best-effort until a fluent speaker checks it. Pronunciations show as
        "audio coming" until we record real Okinawan voices — we never use synthetic Japanese audio.
        Corrections from speakers are always welcome.
      </div>

      <div class="dict-tools">
        <input id="search" class="search" type="search" placeholder="Search in English (e.g. “water”), rōmaji, or kana…" aria-label="Search the dictionary" />
        <div class="filters" id="filters">
          <button class="chip" data-cat="all" aria-pressed="true">All</button>
          {categories.map((c) => <button class="chip" data-cat={c} aria-pressed="false">{c}</button>)}
        </div>
      </div>

      <p id="count" style="color:var(--muted);font-size:.9rem"></p>

      <div class="word-grid" id="grid">
        {entries.map((e) => (
          <article
            class="word-card"
            data-cat={e.category}
            data-en={e.english.join(' | ').toLowerCase()}
            data-term={`${e.headword} ${e.romaji || ''} ${e.kana || ''}`.toLowerCase()}
          >
            <div class="word-head">
              <h2 class="headword">{e.headword}</h2>
              <span class="audio-soon" title="Real Okinawan audio is coming — we don't use synthetic Japanese TTS.">🔊 audio coming</span>
            </div>
            <div class="romaji">
              {e.kana && <span class="kana">{e.kana}</span>}
              {e.ipa && <span class="ipa">{e.ipa}</span>}
            </div>
            <p class="gloss">{e.english.join('; ')}</p>
            {e.examples && e.examples.length > 0 && (
              <p class="example"><em>{e.examples[0].okinawan}</em> — {e.examples[0].english}</p>
            )}
            <div class="word-foot">
              <span class="cat-tag">{e.category}</span>
              <span class="badge-validate">needs validation</span>
            </div>
          </article>
        ))}
      </div>
      <div class="no-results" id="noResults">No matches. Try a different word.</div>

      <p style="color:var(--muted);font-size:.8rem;margin-top:2rem;border-top:1px solid rgba(29,52,97,.1);padding-top:1rem">
        Dictionary data includes material from Wiktionary, used under
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>,
        extracted via Kaikki.org (wiktextract). The Uchinaguchi Project adds, corrects, and validates entries
        with the Okinawan community; the language belongs to its speakers.
      </p>
    </div>
  </section>

  <script>
    const search = document.getElementById('search');
    const grid = document.getElementById('grid');
    const cards = Array.from(grid.querySelectorAll('.word-card'));
    const original = cards.slice(); // remember the original (alphabetical) order
    const chips = Array.from(document.querySelectorAll('.chip'));
    const count = document.getElementById('count');
    const noResults = document.getElementById('noResults');
    let activeCat = 'all';

    function esc(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    // Higher score = better match. English-meaning matches rank above incidental ones.
    function score(card, q) {
      const en = card.dataset.en || '';        // english glosses, " | "-separated
      const term = card.dataset.term || '';    // headword + romaji + kana
      const glosses = en.split(' | ');
      const wordRe = new RegExp('\\b' + esc(q) + '\\b');

      if (glosses.includes(q)) return 100;                 // exact English meaning ("water")
      if (term.split(/\s+/).includes(q)) return 95;        // exact Okinawan term
      if (glosses.some((g) => g.startsWith(q + ' ') || g === q)) return 90; // gloss starts with it
      if (wordRe.test(en)) return 80;                      // whole English word inside a phrase
      if (term.startsWith(q)) return 70;                   // Okinawan term starts with query
      if (en.includes(q)) return 50;                       // partial English
      if (term.includes(q)) return 40;                     // partial Okinawan
      return -1;                                           // no match
    }

    function apply() {
      const q = (search.value || '').toLowerCase().trim();
      const matched = [];

      cards.forEach((card) => {
        const okCat = activeCat === 'all' || card.dataset.cat === activeCat;
        if (!okCat) { card.style.display = 'none'; return; }
        if (!q) { card.style.display = ''; return; }
        const s = score(card, q);
        if (s < 0) { card.style.display = 'none'; }
        else { card.style.display = ''; matched.push([s, card]); }
      });

      if (q) {
        // best matches first; stable by original order within the same score
        matched.sort((a, b) => b[0] - a[0] || original.indexOf(a[1]) - original.indexOf(b[1]));
        matched.forEach(([, card]) => grid.appendChild(card));
      } else {
        // restore original alphabetical order
        original.forEach((card) => grid.appendChild(card));
      }

      const visible = cards.filter((c) => c.style.display !== 'none').length;
      count.textContent = q ? `${visible} match${visible === 1 ? '' : 'es'} for “${search.value.trim()}”` : `${visible} words`;
      noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    search.addEventListener('input', apply);
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');
        activeCat = chip.dataset.cat;
        apply();
      });
    });
    apply();
  </script>
</Base>
