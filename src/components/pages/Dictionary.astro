---
import base from '../../../data/dictionary.clean.json';
import wik from '../../../data/wiktionary-import.json';
import { readFileSync } from 'node:fs';
import { useTranslations, catLabel } from '../../i18n/ui.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const seen = new Set();
const entries = [];
for (const e of [...base.entries, ...wik.entries]) {
  const key = (e.headword || '').toLowerCase().trim();
  if (!key || seen.has(key)) continue;
  seen.add(key);
  entries.push(e);
}
entries.sort((a, b) => a.headword.localeCompare(b.headword));
const categories = [...new Set(entries.map((e) => e.category))].sort();
const total = entries.length;
// NINJAL's dictionary is too big to put in the page, so the browser loads it.
// Count it here so the page can say how many words there are before it loads.
const ninjalTotal = JSON.parse(readFileSync('public/data/ninjal-okinawago.json', 'utf-8')).entries.length;
const numLocale = { en: 'en-US', ja: 'ja-JP', es: 'es-ES', 'pt-br': 'pt-BR' }[lang] || 'en-US';
const ninjalTotalText = ninjalTotal.toLocaleString(numLocale);
// Every entry carries a status; anything unknown is shown as needing validation.
const statusKey = (s) => ({
  attested: 'dict.statusAttested',
  speaker_verified: 'dict.statusVerified',
  proposed_reconstruction: 'dict.statusReconstruction',
}[s] || 'dict.needsValidation');
---
<section>
  <div class="container">
    <h1>{t('dict.title')}</h1>
    <p style="color:var(--muted);max-width:680px" set:html={t('dict.intro', { count: total }).replace('Type an English word', '<strong>Type an English word</strong>')} />

    <p class="ninjal-summary">{t('dict.ninjalSummary', { count: ninjalTotalText })} <a href="#ninjal">{t('dict.ninjalBrowse')} ↓</a></p>

    <div class="notice">{t('dict.notice')}</div>
    <p style="color:var(--muted);font-size:.85rem;margin:-.5rem 0 1rem">{t('dict.englishNote')}</p>

    <div class="dict-tools">
      <input id="search" class="search" type="search" placeholder={t('dict.search')} aria-label={t('dict.search')} />
      <div class="filters" id="filters">
        <button class="chip" data-cat="all" aria-pressed="true">{t('common.all')}</button>
        {categories.map((c) => <button class="chip" data-cat={c} aria-pressed="false">{catLabel(lang, c)}</button>)}
      </div>
    </div>

    <p id="count" style="color:var(--muted);font-size:.9rem"></p>

    <div class="word-grid" id="grid">
      {entries.map((e) => (
        <article
          class="word-card"
          data-cat={e.category}
          data-en={e.english.join(' | ').toLowerCase()}
          data-term={`${e.headword} ${e.romaji || ''} ${e.kana || ''}`.toLowerCase()}
        >
          <div class="word-head">
            <h2 class="headword">{e.headword}</h2>
            <span class="audio-soon">🔊 {t('dict.audioComing')}</span>
          </div>
          <div class="romaji">
            {e.kana && <span class="kana">{e.kana}</span>}
            {e.ipa && <span class="ipa">{e.ipa}</span>}
          </div>
          <p class="gloss">{e.english.join('; ')}</p>
          {e.examples && e.examples.length > 0 && (
            <p class="example"><em>{e.examples[0].okinawan}</em> — {e.examples[0].english}</p>
          )}
          {e.source && (
            <p class="source-line">{t('dict.source')}: {e.source}{e.license ? ` · ${e.license}` : ''}</p>
          )}
          <div class="word-foot">
            <span class="cat-tag">{catLabel(lang, e.category)}</span>
            <span class={`badge-status status-${e.status || 'needs_validation'}`}>{t(statusKey(e.status))}</span>
          </div>
        </article>
      ))}
    </div>
    <div class="no-results" id="noResults">{t('dict.noResults')}</div>

    <section class="ninjal" id="ninjal" aria-labelledby="ninjalTitle">
      <h2 id="ninjalTitle">{t('dict.ninjalTitle')}</h2>
      <p style="color:var(--muted);max-width:680px">{t('dict.ninjalIntro', { count: ninjalTotalText })}</p>
      <div class="filters ninjal-letters" id="ninjalLetters"></div>
      <p id="ninjalCount" style="color:var(--muted);font-size:.9rem">{t('dict.ninjalLoading')}</p>
      <div class="word-grid" id="ninjalGrid"></div>
      <nav class="ninjal-pager" id="ninjalPager" hidden>
        <button class="chip" type="button" id="ninjalPrev">← {t('dict.ninjalPrev')}</button>
        <span id="ninjalPageInfo"></span>
        <button class="chip" type="button" id="ninjalNext">{t('dict.ninjalNext')} →</button>
      </nav>
      <p style="color:var(--muted);font-size:.8rem;margin-top:1rem">
        {t('dict.ninjalAttribution')} <a href="https://mmsrv.ninjal.ac.jp/okinawago/en/index.html" rel="noopener">mmsrv.ninjal.ac.jp</a> · <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener license">CC BY 4.0</a>
      </p>
    </section>

    <p style="color:var(--muted);font-size:.8rem;margin-top:2rem;border-top:1px solid rgba(29,52,97,.1);padding-top:1rem">{t('dict.attribution')}</p>
  </div>
</section>

<script define:vars={{
  wordsLabel: t('dict.words'),
  matchesLabel: t('dict.matchesFor'),
  ninjal: {
    hint: t('dict.ninjalHint'),
    loading: t('dict.ninjalLoading'),
    error: t('dict.ninjalError'),
    none: t('dict.ninjalNone'),
    matches: t('dict.ninjalMatches'),
    range: t('dict.ninjalRange'),
    allLetters: t('dict.ninjalAllLetters'),
    numLocale,
    source: t('dict.source'),
    sourceName: t('dict.ninjalSourceShort'),
    page: t('dict.ninjalPage'),
    status: t('dict.statusAttested'),
    unclear: t('dict.ninjalUnclear'),
  },
}}>
  const search = document.getElementById('search');
  const grid = document.getElementById('grid');
  const cards = Array.from(grid.querySelectorAll('.word-card'));
  const idx = new Map(cards.map((c, i) => [c, i]));
  const chips = Array.from(document.querySelectorAll('.chip'));
  const count = document.getElementById('count');
  const noResults = document.getElementById('noResults');
  let activeCat = 'all';

  function esc(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

  function score(card, q) {
    const en = card.dataset.en || '';
    const term = card.dataset.term || '';
    const glosses = en.split(' | ');
    const wordRe = new RegExp('\\b' + esc(q) + '\\b');
    if (glosses.includes(q)) return 100;
    if (term.split(/\s+/).includes(q)) return 95;
    if (glosses.some((g) => g.startsWith(q + ' ') || g === q)) return 90;
    if (wordRe.test(en)) return 80;
    if (term.startsWith(q)) return 70;
    if (en.includes(q)) return 50;
    if (term.includes(q)) return 40;
    return -1;
  }

  // Reorder via the CSS `order` property instead of moving DOM nodes — one repaint, not 327 reflows.
  function apply() {
    const q = (search.value || '').toLowerCase().trim();
    let visible = 0;
    if (q) {
      const matched = [];
      cards.forEach((card) => {
        const okCat = activeCat === 'all' || card.dataset.cat === activeCat;
        if (!okCat) { card.style.display = 'none'; return; }
        const s = score(card, q);
        if (s < 0) { card.style.display = 'none'; }
        else matched.push([s, card]);
      });
      matched.sort((a, b) => b[0] - a[0] || idx.get(a[1]) - idx.get(b[1]));
      matched.forEach(([, card], i) => { card.style.display = ''; card.style.order = i; visible++; });
    } else {
      cards.forEach((card) => {
        const okCat = activeCat === 'all' || card.dataset.cat === activeCat;
        card.style.display = okCat ? '' : 'none';
        card.style.order = '';
        if (okCat) visible++;
      });
    }
    count.textContent = q ? `${visible} ${matchesLabel} “${search.value.trim()}”` : `${visible} ${wordsLabel}`;
    noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  search.addEventListener('input', apply);

  // NINJAL's dictionary is large, so it loads when the section comes near
  // the screen or someone searches. Everyone can browse all of it a page at a time.
  const nSection = document.getElementById('ninjal');
  const nGrid = document.getElementById('ninjalGrid');
  const nCount = document.getElementById('ninjalCount');
  const nLetters = document.getElementById('ninjalLetters');
  const nPager = document.getElementById('ninjalPager');
  const nPrev = document.getElementById('ninjalPrev');
  const nNext = document.getElementById('ninjalNext');
  const nPageInfo = document.getElementById('ninjalPageInfo');
  const PAGE = 60;
  let nData = null;
  let nLoading = null;
  let nTimer = null;
  let nList = [];
  let nPage = 0;
  let nLetter = 'all';

  const fmt = (n) => n.toLocaleString(ninjal.numLocale);
  const norm = (s) => s.toLowerCase().replace(/[ʔ?]/g, '?');
  const romanGlottal = (s) => s.replace(/\?(?=[a-zA-Z'])/g, 'ʔ');
  // Headwords that start with a hyphen are suffixes and endings; they get their own group.
  const initial = (e) => (/^[a-z]/.test(e.keyPlain) ? e.keyPlain[0] : e.keyPlain.startsWith('-') ? '-' : '#');

  function loadNinjal() {
    if (!nLoading) {
      nCount.textContent = ninjal.loading;
      nLoading = fetch('/data/ninjal-okinawago.json')
        .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then((d) => {
          nData = d.entries.map((e) => {
            const key = norm(e.h);
            return { ...e, key, keyPlain: key.replace(/\?/g, ''), mj: e.m.join(' ') };
          });
          buildLetters();
          applyNinjal();
        })
        .catch(() => { nLoading = null; nCount.textContent = ninjal.error; });
    }
    return nLoading;
  }

  function buildLetters() {
    const letters = [...new Set(nData.map(initial))].sort();
    const make = (value, label) => {
      const b = el('button', 'chip', label);
      b.type = 'button';
      b.dataset.letter = value;
      b.setAttribute('aria-pressed', value === nLetter ? 'true' : 'false');
      b.addEventListener('click', () => {
        nLetter = value;
        nLetters.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', c === b ? 'true' : 'false'));
        applyNinjal();
      });
      return b;
    };
    nLetters.replaceChildren(make('all', ninjal.allLetters), ...letters.map((l) => make(l, l === '-' ? '-…' : l.toUpperCase())));
  }

  function nScore(e, q, qPlain) {
    if (e.key === q || e.keyPlain === qPlain) return 100;
    if (e.key.startsWith(q) || e.keyPlain.startsWith(qPlain)) return 80;
    if (e.mj.startsWith(q)) return 70;
    if (e.mj.includes(q)) return 50;
    if (q.length > 2 && (e.key.includes(q) || e.keyPlain.includes(qPlain))) return 30;
    return -1;
  }

  function el(tag, cls, text) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function nCard(e) {
    const card = el('article', 'word-card');
    const head = el('div', 'word-head');
    head.append(el('h3', 'headword', e.h));
    if (e.p) head.append(el('span', 'cat-tag', e.p));
    card.append(head);
    card.append(el('p', 'gloss', romanGlottal(e.m.slice(0, 2).join(' / '))));
    card.append(el('p', 'source-line', `${ninjal.source}: ${ninjal.sourceName}, ${ninjal.page} ${e.pg} · CC BY 4.0`));
    const foot = el('div', 'word-foot');
    foot.append(el('span', 'badge-status status-attested', ninjal.status));
    if (e.f) foot.append(el('span', 'badge-status', ninjal.unclear));
    card.append(foot);
    return card;
  }

  // Rebuild the list for the current search and letter, then show page one.
  function applyNinjal() {
    if (!nData) { loadNinjal(); return; }
    const raw = (search.value || '').trim();
    const pool = nLetter === 'all' ? nData : nData.filter((e) => initial(e) === nLetter);
    if (raw) {
      const q = norm(raw);
      const qPlain = q.replace(/\?/g, '');
      const hits = [];
      for (const e of pool) {
        const s = nScore(e, q, qPlain);
        if (s >= 0) hits.push([s, e]);
      }
      hits.sort((a, b) => b[0] - a[0] || a[1].h.length - b[1].h.length);
      nList = hits.map(([, e]) => e);
    } else {
      nList = pool; // dictionary order, as NINJAL published it
    }
    nPage = 0;
    renderPage(false);
  }

  function renderPage(scroll) {
    const pages = Math.max(1, Math.ceil(nList.length / PAGE));
    nPage = Math.min(Math.max(nPage, 0), pages - 1);
    const from = nPage * PAGE;
    const shown = nList.slice(from, from + PAGE);
    const frag = document.createDocumentFragment();
    shown.forEach((e) => frag.append(nCard(e)));
    nGrid.replaceChildren(frag);
    const range = ninjal.range
      .replace('{from}', fmt(nList.length ? from + 1 : 0))
      .replace('{to}', fmt(from + shown.length))
      .replace('{total}', fmt(nList.length));
    const raw = (search.value || '').trim();
    nCount.textContent = nList.length === 0
      ? ninjal.none
      : raw ? `${fmt(nList.length)} ${ninjal.matches} · ${range}` : range;
    nPager.hidden = pages <= 1;
    nPrev.disabled = nPage === 0;
    nNext.disabled = nPage >= pages - 1;
    nPageInfo.textContent = `${fmt(nPage + 1)} / ${fmt(pages)}`;
    if (scroll) nSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  nPrev.addEventListener('click', () => { nPage--; renderPage(true); });
  nNext.addEventListener('click', () => { nPage++; renderPage(true); });

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((seen) => {
      if (seen.some((s) => s.isIntersecting)) { io.disconnect(); loadNinjal(); }
    }, { rootMargin: '800px 0px' });
    io.observe(nSection);
  } else {
    loadNinjal();
  }
  if (location.hash === '#ninjal') loadNinjal();
  window.addEventListener('hashchange', () => { if (location.hash === '#ninjal') loadNinjal(); });

  search.addEventListener('input', () => {
    clearTimeout(nTimer);
    nTimer = setTimeout(applyNinjal, 200);
  });
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
    chip.setAttribute('aria-pressed', 'true');
    activeCat = chip.dataset.cat;
    apply();
  }));
  apply();
</script>
