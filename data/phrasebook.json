      "name": "Greetings",
      "phrases": [
        { "okinawan": "Haisai", "romaji": "haisai", "english": "Hello (said by men)", "note": "Casual, everyday greeting." },
        { "okinawan": "Haitai", "romaji": "haitai", "english": "Hello (said by women)", "note": "Casual, everyday greeting." },
        { "okinawan": "Chuu uganabira", "romaji": "chuu uganabira", "english": "Good day (polite greeting)", "note": "More formal than haisai/haitai." },
        { "okinawan": "Mensoore", "romaji": "mensoore", "english": "Welcome", "note": "Often seen welcoming visitors to Okinawa." },
        { "okinawan": "Yutasarugutu unigeesabira", "romaji": "yutasarugutu unigeesabira", "english": "Nice to meet you / please treat me kindly", "note": "Polite self-introduction." }
