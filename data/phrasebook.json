    },
    {
      "name": "Courtesy & feeling",
      "phrases": [
        { "okinawan": "Nifee deebiru", "romaji": "nifee deebiru", "english": "Thank you", "note": "Common expression of gratitude." },
        { "okinawan": "Ichariba choodee", "romaji": "ichariba choodee", "english": "Once we meet, we are family", "note": "A cherished saying of Okinawan hospitality." },
        { "okinawan": "Ganjuu yami?", "romaji": "ganjuu yami?", "english": "Are you well? / How are you?", "note": "Ganjuu means healthy, strong." }
      ]
    },
    {
      "name": "Basics: yes, no, understanding",
      "phrases": [
        { "okinawan": "Uu", "romaji": "uu", "english": "Yes", "note": "" },
        { "okinawan": "Aran", "romaji": "aran", "english": "No / it is not", "note": "" },
        { "okinawan": "Wakaran", "romaji": "wakaran", "english": "I don't understand", "note": "Useful while learning." }
      ]
    },
    {
      "name": "Eating",
      "phrases": [
        { "okinawan": "Kamee!", "romaji": "kamee", "english": "Eat up! / Let's eat", "note": "Warm invitation to a meal." },
        { "okinawan": "Maasan", "romaji": "maasan", "english": "Delicious", "note": "" }
